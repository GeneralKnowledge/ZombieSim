; Engine configuration file.
; Million Dot — Godot Mass-NPC 3D Simulation Prototype

config_version=5

[application]

config/name="Million Dot"
config/description="Godot mass-NPC technical prototype: data-oriented population, MultiMesh rendering, hordes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SimConfig="*res://scripts/autoload/sim_config.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/vsync/vsync_mode=0

